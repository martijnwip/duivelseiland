{
  "name": "duivelseiland",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun node_modules/.bin/payload migrate --disable-transpile && bun --bun next build",
    "start": "bun --bun next start",
    "payload": "bun --bun node_modules/.bin/payload --disable-transpile",
    "seed:admin": "bun run scripts/seed-admin.ts",
    "seed:geschiedenis": "bun run scripts/seed-geschiedenis.ts",
    "seed:intro": "bun run scripts/seed-intro.ts",
    "seed:intro:prod": "bun --env-file=.env.production.local run scripts/seed-intro.ts",
    "foto:vervang": "bun run scripts/vervang-historische-foto.ts",
    "foto:vervang:prod": "bun --env-file=.env.production.local run scripts/vervang-historische-foto.ts",
    "dev:login": "bun run scripts/dev-login.ts",
    "export:local": "bun run scripts/export.ts local",
    "export:prod": "bun --env-file=.env.production.local run scripts/export.ts prod",
    "db:pull": "bun run scripts/pull-prod-db.ts",
    "reseed:local": "bun run scripts/reseed.ts",
    "reseed:prod": "bun --env-file=.env.production.local run scripts/reseed.ts",
    "afval:deelkaart": "KAART=afval bun run scripts/afval-deelkaart.ts",
    "geluid:deelkaart": "KAART=geluid bun run scripts/afval-deelkaart.ts",
    "kaart:locatie": "bun run scripts/locatiekaart.ts",
    "translate": "translate/.venv/bin/python translate/translate.py",
    "translate:setup": "python3 -m venv translate/.venv && translate/.venv/bin/pip install -r translate/requirements.txt"
  },
  "dependencies": {
    "@delmaredigital/payload-better-auth": "0.13.0",
    "@libsql/client": "^0.14.0",
    "@payloadcms/db-sqlite": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/storage-vercel-blob": "3.89.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "better-auth": "1.7.5",
    "next": "15.5.25",
    "next-intl": "^4.14.4",
    "next-themes": "^0.4.6",
    "payload": "3.89.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-slideshow-image": "^4.4.0",
    "resend": "6.28.1",
    "sharp": "^0.33.5",
    "undici": "^7.29.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.0.0",
    "dotenv": "^17.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0"
  }
}
