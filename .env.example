# Payload
PAYLOAD_SECRET=change-me-to-a-random-string

# Database — SQLite locally, Turso in production
DATABASE_URI=file:./dev.db

# Server URL (for Payload serverURL + next/image remotePatterns)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob — leave empty locally (falls back to local storage)
BLOB_READ_WRITE_TOKEN=

# Better Auth (magic-link login op /admin) — genereer een losse, willekeurige
# string van 32+ tekens, niet gelijk aan PAYLOAD_SECRET
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string

# Resend (verzenden van magic-link e-mails) — leeg laten lokaal logt de link
# naar de console i.p.v. te versturen
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Ontvanger van het contactformulier (/contact). Leeg = alle redacteuren en admins.
CONTACT_EMAIL=duiveltjes@proton.me

# Vertaalcontrole (TypeSafe). Aan = TRANSLATION_CHECK=on, met een sleutel; anders uit.
TYPESAFE_API_KEY=
TRANSLATION_CHECK=

# Vercel Cron: geheim voor de dagelijkse taken (/api/activiteiten-opruimen, /api/nieuwsbrief-verzenden).
# Vercel stuurt het mee als "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Optioneel: max. aantal bulkmails per 24 uur, berichten van organisatoren en de nieuwsbrief samen (standaard 80).
ACTIVITEITEN_MAIL_DAGLIMIET=
# Optioneel: deel daarvan voor de nieuwsbrief (standaard 60); de rest gaat met de dagelijkse cron.
NIEUWSBRIEF_DAGLIMIET=
